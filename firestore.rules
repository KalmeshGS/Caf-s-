rules_version = '2';
// =====================================================================
//  Cafe Journal — Firestore security rules
//  Paste this whole file into Firebase console → Firestore → Rules → Publish.
//  Every read/write is checked here on Google's servers, so a modified
//  app cannot get around them.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function memberDoc(cid) { return get(/databases/$(database)/documents/cafes/$(cid)/members/$(request.auth.uid)); }
    function isMember(cid) { return signedIn() && exists(/databases/$(database)/documents/cafes/$(cid)/members/$(request.auth.uid)); }
    // Active, not disabled, and (for staff) not locked after wrong passwords
    function ok(cid) {
      return isMember(cid) && memberDoc(cid).data.active == true
        && (memberDoc(cid).data.get('loginId', null) == null
            || get(/databases/$(database)/documents/cafes/$(cid)/logins/$(memberDoc(cid).data.loginId)).data.locked == false);
    }
    function role(cid) { return memberDoc(cid).data.role; }
    function can(cid, roles) { return ok(cid) && role(cid) in roles; }
    function owner(cid) { return can(cid, ['owner']); }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---------- public café card (name shown on the login page) ----------
    match /cafes/{cid} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['name', 'short', 'tagline', 'ownerUid', 'createdAt']);
      allow update: if owner(cid) && onlyKeys(['name', 'short', 'tagline']);
      allow delete: if false;

      // ---------- people & logins ----------
      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || owner(cid));
        allow list: if owner(cid);
        // The café creator adds themself as the first owner
        allow create: if (signedIn() && uid == request.auth.uid
                          && get(/databases/$(database)/documents/cafes/$(cid)).data.ownerUid == request.auth.uid
                          && request.resource.data.role == 'owner')
                      || owner(cid);
        allow update: if owner(cid)
                      || (signedIn() && uid == request.auth.uid && onlyKeys(['mustChange', 'lastLogin'])
                          && request.resource.data.mustChange == false);
        allow delete: if owner(cid) && uid != request.auth.uid;
      }

      // One document per staff login ID: which hidden email it uses, and the lock state
      match /logins/{loginId} {
        allow get: if true;            // needed before signing in (contains no personal data)
        allow list: if owner(cid);
        allow create, delete: if owner(cid);
        allow update: if owner(cid)
          // Signed-out wrong password: may only add exactly one failed attempt; 4 locks the account
          || (!signedIn() && resource.data.locked == false && onlyKeys(['failed', 'locked', 'lockedAt'])
              && request.resource.data.failed == resource.data.failed + 1
              && request.resource.data.locked == (request.resource.data.failed >= 4)
              && (request.resource.data.locked == false || request.resource.data.lockedAt == request.time))
          // Successful sign-in: the person may only reset their own counter
          || (signedIn() && request.auth.uid == resource.data.uid && resource.data.locked == false
              && onlyKeys(['failed']) && request.resource.data.failed == 0);
      }

      // "Forgot password" requests: anyone may ask for an existing login; only owners read them.
      // The document id must be the login ID, so there is at most ONE open request per login
      // (asking again while it is open is refused) — nobody can flood the owner's dashboard.
      function validRequest(rid) {
        let d = request.resource.data;
        return d.keys().hasOnly(['id', 'loginId', 'userId', 'type', 'status', 'createdAt'])
          && rid == d.loginId && d.id == rid
          && d.status == 'open'
          && d.type in ['reset', 'unlock']
          && d.createdAt is number
          && exists(/databases/$(database)/documents/cafes/$(cid)/logins/$(d.loginId))
          && get(/databases/$(database)/documents/cafes/$(cid)/logins/$(d.loginId)).data.uid == d.userId;
      }
      match /requests/{rid} {
        allow create: if validRequest(rid);
        // a closed (done / dismissed) request may be opened again by a new ask
        allow update: if owner(cid) || (resource.data.status != 'open' && validRequest(rid));
        allow read, delete: if owner(cid);
      }

      // ---------- café data, by role ----------
      match /meta/settings { allow read: if ok(cid); allow write: if owner(cid); }
      match /meta/seq { allow read: if ok(cid); allow write: if can(cid, ['owner', 'manager', 'cashier', 'waiter', 'captain']); }

      match /menu/{id}       { allow read: if ok(cid); allow write: if can(cid, ['owner', 'manager', 'kitchen']); }
      // Bills. Floor staff open and edit them; only cashier / manager / owner take payment;
      // once paid, a bill can be changed or deleted by the owner only.
      match /orders/{id} {
        function floor() { return can(cid, ['owner', 'manager', 'cashier', 'waiter', 'captain']); }
        function isNum(v) { return v is int || v is float; }
        // The payment fields must be sane: discount within the subtotal, total = subtotal - discount + tax
        function validPayment(d) {
          // split = several ways, credit = pay later, comp = free (discount = whole subtotal)
          // charges = packing + service charge (0 when none)
          return d.status == 'paid'
            && d.method in ['cash', 'upi', 'card', 'split', 'credit', 'comp']
            && isNum(d.paidAt) && isNum(d.subtotal) && isNum(d.discount) && isNum(d.tax) && isNum(d.total)
            && isNum(d.get('charges', 0)) && d.get('charges', 0) >= 0
            && d.subtotal >= 0 && d.discount >= 0 && d.discount <= d.subtotal && d.tax >= 0
            && (d.method != 'comp' || d.discount == d.subtotal)
            && math.abs(d.total - (d.subtotal - d.discount + d.tax + d.get('charges', 0))) < 0.01;
        }
        allow read: if ok(cid);
        // New bills always start open (the owner may also upload old paid bills, e.g. moving an offline café online)
        allow create: if owner(cid) || (floor() && request.resource.data.status == 'open');
        allow update: if owner(cid)
          // open bill stays open: add / change items, notes, table
          || (floor() && resource.data.status == 'open' && request.resource.data.status == 'open')
          // open bill gets paid: billing roles only, with valid amounts
          || (can(cid, ['manager', 'cashier']) && resource.data.status == 'open' && validPayment(request.resource.data))
          // cancel an open bill (kept, with a reason, for the owner's leakage check)
          || (can(cid, ['manager', 'cashier']) && resource.data.status == 'open' && request.resource.data.status == 'cancelled'
              && request.resource.data.cancelReason is string && request.resource.data.cancelReason.size() > 0)
          // credit bill: the money is collected later
          || (can(cid, ['manager', 'cashier']) && resource.data.status == 'paid' && resource.data.method == 'credit'
              && !('creditPaid' in resource.data) && onlyKeys(['creditPaid']));
        // Floor staff may only remove an open bill that has no items left (what the app does)
        allow delete: if owner(cid)
          || (floor() && resource.data.status == 'open' && resource.data.get('items', []).size() == 0);
      }
      // Kitchen tickets: floor staff send them (status "new"), can change them until the kitchen
      // starts cooking, and mark ready food as served. Only the kitchen and the owner start cooking / mark ready.
      match /kots/{id} {
        allow read: if ok(cid);
        allow create: if can(cid, ['owner', 'manager', 'cashier', 'waiter', 'captain']) && request.resource.data.status == 'new';
        allow update: if can(cid, ['owner', 'kitchen', 'captain'])
          // while the kitchen hasn't started, floor staff may change the ticket (items, quantities, instructions)
          || (can(cid, ['manager', 'cashier', 'waiter']) && resource.data.status == 'new' && request.resource.data.status == 'new')
          || (can(cid, ['manager', 'cashier', 'waiter']) && resource.data.status == 'ready'
              && request.resource.data.status == 'served' && onlyKeys(['status', 'updatedAt', 'stockDone', 'outcome']))
          // guests moved to another table: the ticket follows them
          || (can(cid, ['manager', 'cashier', 'waiter']) && request.resource.data.status == resource.data.status
              && onlyKeys(['table', 'movedFrom', 'updatedAt']));
        allow delete: if can(cid, ['owner', 'kitchen', 'captain'])
          || (can(cid, ['manager', 'cashier', 'waiter']) && resource.data.status == 'new');
      }
      match /stock/{id} {
        allow read: if can(cid, ['owner', 'manager', 'kitchen', 'captain']);
        // stock can never be negative
        allow create, update: if can(cid, ['owner', 'manager']) && request.resource.data.qty is number && request.resource.data.qty >= 0;
        allow delete: if can(cid, ['owner', 'manager']);
        // anyone serving food may only take ingredients OFF the stock (never add, never below 0)
        allow update: if can(cid, ['cashier', 'waiter', 'kitchen', 'captain']) && onlyKeys(['qty'])
          && request.resource.data.qty < resource.data.qty && request.resource.data.qty >= 0;
      }
      match /expenses/{id}   { allow read: if can(cid, ['owner', 'manager', 'cashier']); allow write: if can(cid, ['owner', 'manager']); }
      match /vendors/{id}    { allow read, write: if can(cid, ['owner', 'manager']); }
      match /vendorTx/{id}   { allow read, write: if can(cid, ['owner', 'manager']); }
      match /staff/{id}      { allow read: if can(cid, ['owner', 'manager', 'cashier']); allow write: if can(cid, ['owner', 'manager']); }
      match /staffPrivate/{id} { allow read, write: if owner(cid); }   // salary, KYC, address, DOB…
      match /attendance/{day} { allow read: if can(cid, ['owner', 'manager', 'cashier']); allow write: if can(cid, ['owner', 'manager']); }
      match /journal/{day}   { allow read, write: if can(cid, ['owner', 'manager', 'cashier']); }
      match /tables/{table}  {
        allow read: if ok(cid);
        allow write: if can(cid, ['owner', 'manager', 'cashier', 'waiter', 'captain']);
        // housekeeping: mark a table "Needs cleaning" or cleaned (removes the status) — nothing else
        allow create, update: if can(cid, ['housekeeping']) && request.resource.data.status == 'cleaning';
        allow delete: if can(cid, ['housekeeping']) && resource.data.status == 'cleaning';
      }
      match /notices/{id}    { allow read: if ok(cid); allow write: if can(cid, ['owner', 'manager']); }
      // Stock & profit: purchases, wastage and stock corrections. The kitchen may only record wastage.
      match /stockLog/{id} {
        allow read: if can(cid, ['owner', 'manager', 'kitchen']);
        allow create: if can(cid, ['owner', 'manager']) || (can(cid, ['kitchen']) && request.resource.data.type == 'waste');
        allow update, delete: if can(cid, ['owner', 'manager']);
      }
      // Leakage check: anyone working adds events (append-only); only the owner and manager read them
      match /audit/{id} {
        allow read: if can(cid, ['owner', 'manager']);
        allow create: if ok(cid) && request.resource.data.type is string;
        allow update, delete: if owner(cid);
      }
      match /reservations/{id} { allow read: if can(cid, ['owner', 'manager', 'cashier', 'waiter', 'captain', 'housekeeping']); allow write: if can(cid, ['owner', 'manager', 'cashier', 'waiter', 'captain']); }
    }

    // Which café an owner belongs to (so owners can log in with just email + password)
    match /profiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && get(/databases/$(database)/documents/cafes/$(request.resource.data.cafeId)).data.ownerUid == uid;
      allow update, delete: if false;
    }
  }
}
