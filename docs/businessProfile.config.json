  "competitorGapsToFix": [
    {
      "issue": "paid add-ons for basics",
      "fix": "captain app, KDS, token display, leakage panel included in base plan; public pricing"
    },
    {
      "issue": "inventory hard to use",
      "fix": "3-level stock, 2-minute daily top-10 count, variance in rupees"
    },
    {
      "issue": "UI not simple enough",
      "fix": "role-based screens from flags, plain words, local languages"
    },
    {
      "issue": "no initials search",
      "fix": "quick_search with initials, short codes, transliteration"
    },
    {
      "issue": "bill SMS shows vendor brand",
      "fix": "own_brand_ebill via restaurant's WhatsApp"
    },
    {
      "issue": "online item on/off unreliable",
      "fix": "single inStock across channels with change log"
    },
    {
      "issue": "setup effort, support delays",
      "fix": "self-serve wizard, menu import from Excel/photo, in-app guides, WhatsApp support"
    },
    {
