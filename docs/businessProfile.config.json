{
  "version": "1.0",
  "app": "Cafe Journal",
  "coreFlags": [
    "menu",
    "billing",
    "day_close",
    "expenses",
    "vendors",
    "staff",
    "auth",
    "reports"
  ],
  "questions": [
    {
      "id": "q_preset",
      "step": 1,
      "type": "single",
      "required": true,
      "options": [
        "darshini",
        "qsr",
        "cafe",
        "casual_dining",
        "fine_dining",
        "meals_hotel",
        "dhaba",
        "bar",
        "cloud_kitchen",
        "bakery",
        "kiosk_small",
        "food_truck",
        "buffet",
        "canteen",
        "mess_tiffin",
        "hotel_rooms",
        "catering"
      ]
    },
    {
      "id": "q_eat_where",
      "step": 2,
      "type": "multi",
      "options": [
        "tables",
        "standing",
        "takeaway",
        "own_delivery",
        "aggregator",
        "rooms"
      ]
    },
    {
      "id": "q_table_count",
      "step": 2,
      "type": "object",
      "showIf": "q_eat_where has tables",
      "fields": {
        "count": "number",
        "areas": "string[]"
      }
    },
    {
      "id": "q_area_pricing",
      "step": 2,
      "type": "boolean",
      "showIf": "q_table_count.areas.length > 1"
    },
    {
      "id": "q_order_by",
      "step": 2,
      "type": "multi",
      "options": [
        "waiter",
        "counter",
        "qr",
        "phone"
      ]
    },
    {
      "id": "q_pay_when",
      "step": 2,
      "type": "multi",
      "options": [
        "prepaid",
        "postpaid",
        "account",
        "room",
        "advance"
      ]
    },
    {
      "id": "q_handoff",
      "step": 2,
      "type": "single",
      "showIf": "q_pay_when has prepaid",
      "options": [
        "serve",
        "token",
        "name",
        "station_coupon",
        "instant"
      ]
    },
    {
      "id": "q_kitchen",
      "step": 2,
      "type": "single",
      "options": [
        "none",
        "single",
        "multi"
      ]
    },
    {
      "id": "q_stations",
      "step": 2,
      "type": "string[]",
      "showIf": "q_kitchen == multi"
    },
    {
      "id": "q_kitchen_device",
      "step": 2,
      "type": "single",
      "showIf": "q_kitchen != none",
      "options": [
        "kds",
        "print",
        "both",
        "verbal"
      ]
    },
    {
      "id": "q_menu_style",
      "step": 2,
      "type": "multi",
      "options": [
        "alacarte",
        "variants",
        "combos",
        "meals",
        "buffet",
        "weight",
        "mrp"
      ]
    },
    {
      "id": "q_time_menus",
      "step": 2,
      "type": "boolean"
    },
    {
      "id": "q_alcohol",
      "step": 2,
      "type": "boolean"
    },
    {
      "id": "q_rooms",
      "step": 2,
      "type": "object",
      "fields": {
        "has": "boolean",
        "count": "number",
        "maxTariff": "number"
      }
    },
    {
      "id": "q_bookings",
      "step": 2,
      "type": "multi",
      "options": [
        "tables",
        "preorders",
        "events",
        "none"
      ]
    },
    {
      "id": "q_regulars",
      "step": 2,
      "type": "multi",
      "options": [
        "credit",
        "wallet",
        "subscription",
        "loyalty",
        "none"
      ]
    },
    {
      "id": "q_brands",
      "step": 2,
      "type": "object",
      "showIf": "q_eat_where has aggregator or own_delivery",
      "fields": {
        "has": "boolean",
        "names": "string[]"
      }
    },
    {
      "id": "q_hours",
      "step": 2,
      "type": "object",
      "fields": {
        "pastMidnight": "boolean",
        "cutoff": "HH:mm"
      }
    },
    {
      "id": "q_internet",
      "step": 2,
      "type": "single",
      "options": [
        "yes",
        "sometimes",
        "often_no"
      ]
    },
    {
      "id": "q_gst",
      "step": 3,
      "type": "single",
      "required": true,
      "options": [
        "regular",
        "composition",
        "none"
      ]
    },
    {
      "id": "q_gstin",
      "step": 3,
      "type": "text",
      "showIf": "q_gst != none",
      "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$"
    },
    {
      "id": "q_fssai",
      "step": 3,
      "type": "text",
      "required": true,
      "pattern": "^[0-9]{14}$"
    },
    {
      "id": "q_price_incl",
      "step": 3,
      "type": "boolean"
    },
    {
      "id": "q_service_charge",
      "step": 3,
      "type": "single",
      "options": [
        "no",
        "optional"
      ],
      "default": "no"
    },
    {
      "id": "q_packing",
      "step": 3,
      "type": "single",
      "options": [
        "none",
        "per_item",
        "per_order"
      ]
    },
    {
      "id": "q_printer",
      "step": 3,
      "type": "single",
      "options": [
        "none",
        "bt58",
        "usb80"
      ]
    },
    {
      "id": "q_stock",
      "step": 4,
      "type": "single",
      "options": [
        "none",
        "purchases",
        "recipe"
      ]
    },
    {
      "id": "q_staff_roles",
      "step": 4,
      "type": "multi",
      "options": [
        "owner",
        "manager",
        "cashier",
        "waiter",
        "chef",
        "bartender",
        "delivery",
        "housekeeping",
        "front_desk"
      ]
    },
    {
      "id": "q_devices",
      "step": 4,
      "type": "multi",
      "options": [
        "owner_phone",
        "counter",
        "waiter_phones",
        "kitchen_tablet",
        "tv"
      ]
    },
    {
      "id": "q_language",
      "step": 4,
      "type": "multi",
      "options": [
        "en",
        "kn",
        "hi",
        "te",
        "ta",
        "mr"
      ]
    }
  ],
